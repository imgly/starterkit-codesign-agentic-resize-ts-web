# Copy to .env (gitignored), then add the variables of src/hosting/cloud/.env.template. Only VITE_* variables reach
# the page.

# CE.SDK licence for the editor the page opens on a result. Dev: a trial key.
VITE_CESDK_LICENSE=

# Optional: the gateway model id the page starts with (default @openrouter/anthropic/claude-haiku-5.5).
VITE_MODEL=

# Never sent to the page: your CoDesign licence key, which pays every model call the agent makes.
IMGLY_GATEWAY_API_KEY=
